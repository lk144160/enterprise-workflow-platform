<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.stock.mapper.BizMaterialMapper">

    <resultMap type="BizMaterial" id="BizMaterialResult">
        <result property="materialId"   column="material_id"   />
        <result property="materialNo"   column="material_no"   />
        <result property="materialName" column="material_name" />
        <result property="spec"         column="spec"          />
        <result property="unit"         column="unit"          />
        <result property="category"     column="category"      />
        <result property="safetyStock"  column="safety_stock"  />
        <result property="refPrice"     column="ref_price"     />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectVo">
        select material_id, material_no, material_name, spec, unit, category, safety_stock, ref_price, status,
               create_by, create_time, update_by, update_time, remark
        from biz_material
    </sql>

    <select id="selectBizMaterialById" parameterType="Long" resultMap="BizMaterialResult">
        <include refid="selectVo"/>
        where material_id = #{materialId}
    </select>

    <select id="selectBizMaterialByNo" parameterType="String" resultMap="BizMaterialResult">
        <include refid="selectVo"/>
        where material_no = #{materialNo} limit 1
    </select>

    <select id="selectBizMaterialList" parameterType="BizMaterial" resultMap="BizMaterialResult">
        <include refid="selectVo"/>
        <where>
            <if test="materialNo != null and materialNo != ''">AND material_no like concat('%', #{materialNo}, '%')</if>
            <if test="materialName != null and materialName != ''">AND material_name like concat('%', #{materialName}, '%')</if>
            <if test="spec != null and spec != ''">AND spec like concat('%', #{spec}, '%')</if>
            <if test="unit != null and unit != ''">AND unit = #{unit}</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by material_id desc
    </select>

    <insert id="insertBizMaterial" parameterType="BizMaterial" useGeneratedKeys="true" keyProperty="materialId">
        insert into biz_material (material_no, material_name, spec, unit, category, safety_stock, ref_price, status, create_by, create_time, remark)
        values (#{materialNo}, #{materialName}, #{spec}, #{unit}, #{category}, #{safetyStock}, #{refPrice}, #{status}, #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateBizMaterial" parameterType="BizMaterial">
        update biz_material
        <set>
            <if test="materialName != null and materialName != ''">material_name = #{materialName},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="safetyStock != null">safety_stock = #{safetyStock},</if>
            <if test="refPrice != null">ref_price = #{refPrice},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where material_id = #{materialId}
    </update>

    <delete id="deleteBizMaterialByIds" parameterType="Long">
        delete from biz_material where material_id in
        <foreach item="materialId" collection="array" open="(" separator="," close=")">
            #{materialId}
        </foreach>
    </delete>
</mapper>
