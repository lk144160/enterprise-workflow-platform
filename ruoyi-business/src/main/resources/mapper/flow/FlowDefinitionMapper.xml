<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.flow.mapper.FlowDefinitionMapper">

    <resultMap type="FlowDefinition" id="FlowDefinitionResult">
        <result property="flowId"       column="flow_id"       />
        <result property="flowCode"     column="flow_code"     />
        <result property="flowName"     column="flow_name"     />
        <result property="bizType"      column="biz_type"      />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectVo">
        select flow_id, flow_code, flow_name, biz_type, status, create_by, create_time, update_by, update_time, remark
        from flow_definition
    </sql>

    <select id="selectFlowDefinitionById" parameterType="Long" resultMap="FlowDefinitionResult">
        <include refid="selectVo"/>
        where flow_id = #{flowId}
    </select>

    <select id="selectFlowDefinitionByCode" parameterType="String" resultMap="FlowDefinitionResult">
        <include refid="selectVo"/>
        where flow_code = #{flowCode}
    </select>

    <select id="selectFlowDefinitionList" parameterType="FlowDefinition" resultMap="FlowDefinitionResult">
        <include refid="selectVo"/>
        <where>
            <if test="flowCode != null and flowCode != ''">AND flow_code like concat('%', #{flowCode}, '%')</if>
            <if test="flowName != null and flowName != ''">AND flow_name like concat('%', #{flowName}, '%')</if>
            <if test="bizType != null and bizType != ''">AND biz_type = #{bizType}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by flow_id
    </select>

    <insert id="insertFlowDefinition" parameterType="FlowDefinition" useGeneratedKeys="true" keyProperty="flowId">
        insert into flow_definition (flow_code, flow_name, biz_type, status, create_by, create_time, remark)
        values (#{flowCode}, #{flowName}, #{bizType}, #{status}, #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateFlowDefinition" parameterType="FlowDefinition">
        update flow_definition
        <set>
            <if test="flowName != null and flowName != ''">flow_name = #{flowName},</if>
            <if test="bizType != null and bizType != ''">biz_type = #{bizType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where flow_id = #{flowId}
    </update>

    <delete id="deleteFlowDefinitionById" parameterType="Long">
        delete from flow_definition where flow_id = #{flowId}
    </delete>

    <delete id="deleteFlowDefinitionByIds" parameterType="Long">
        delete from flow_definition where flow_id in
        <foreach item="flowId" collection="array" open="(" separator="," close=")">
            #{flowId}
        </foreach>
    </delete>
</mapper>
