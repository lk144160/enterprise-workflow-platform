<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.remind.mapper.BizRemindMapper">

    <resultMap type="com.ruoyi.business.remind.domain.BizRemind" id="BizRemindResult">
        <id     property="remindId"       column="remind_id"       />
        <result property="title"          column="title"           />
        <result property="content"        column="content"         />
        <result property="remindTime"     column="remind_time"     />
        <result property="repeatType"     column="repeat_type"     />
        <result property="relateType"     column="relate_type"     />
        <result property="relateId"       column="relate_id"       />
        <result property="relateName"     column="relate_name"     />
        <result property="receiverId"     column="receiver_id"     />
        <result property="receiverName"   column="receiver_name"   />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectVo">
        select r.remind_id, r.title, r.content, r.remind_time, r.repeat_type, r.relate_type, r.relate_id,
               r.relate_name, r.receiver_id, r.status, r.create_by, r.create_time, r.update_by, r.update_time, r.remark,
               u.nick_name as receiver_name
        from biz_remind r
        left join sys_user u on u.user_id = r.receiver_id
    </sql>

    <select id="selectBizRemindList" parameterType="com.ruoyi.business.remind.domain.BizRemind" resultMap="BizRemindResult">
        <include refid="selectVo"/>
        <where>
            <if test="title != null and title != ''">
                and r.title like concat('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                and r.status = #{status}
            </if>
            <if test="repeatType != null and repeatType != ''">
                and r.repeat_type = #{repeatType}
            </if>
            <if test="relateType != null and relateType != ''">
                and r.relate_type = #{relateType}
            </if>
            <if test="relateId != null">
                and r.relate_id = #{relateId}
            </if>
            <if test="receiverId != null">
                and r.receiver_id = #{receiverId}
            </if>
            <if test="mineUserId != null">
                and (r.receiver_id = #{mineUserId} or r.create_by = #{mineUserName})
            </if>
        </where>
        order by r.status asc, r.remind_time desc
    </select>

    <select id="selectBizRemindById" parameterType="Long" resultMap="BizRemindResult">
        <include refid="selectVo"/>
        where r.remind_id = #{remindId}
    </select>

    <select id="selectDueRemindList" resultMap="BizRemindResult">
        select r.remind_id, r.title, r.content, r.remind_time, r.repeat_type, r.relate_type, r.relate_id,
               r.relate_name, r.receiver_id, r.status, r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from biz_remind r
        where r.status = '0' and r.remind_time &lt;= now()
        order by r.remind_time asc
        limit 200
    </select>

    <insert id="insertBizRemind" parameterType="com.ruoyi.business.remind.domain.BizRemind" useGeneratedKeys="true" keyProperty="remindId">
        insert into biz_remind
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="content != null">content,</if>
            <if test="remindTime != null">remind_time,</if>
            <if test="repeatType != null and repeatType != ''">repeat_type,</if>
            <if test="relateType != null and relateType != ''">relate_type,</if>
            <if test="relateId != null">relate_id,</if>
            <if test="relateName != null">relate_name,</if>
            <if test="receiverId != null">receiver_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="remindTime != null">#{remindTime},</if>
            <if test="repeatType != null and repeatType != ''">#{repeatType},</if>
            <if test="relateType != null and relateType != ''">#{relateType},</if>
            <if test="relateId != null">#{relateId},</if>
            <if test="relateName != null">#{relateName},</if>
            <if test="receiverId != null">#{receiverId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateBizRemind" parameterType="com.ruoyi.business.remind.domain.BizRemind">
        update biz_remind
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            content = #{content},
            <if test="remindTime != null">remind_time = #{remindTime},</if>
            <if test="repeatType != null and repeatType != ''">repeat_type = #{repeatType},</if>
            relate_type = #{relateType},
            relate_id = #{relateId},
            relate_name = #{relateName},
            <if test="receiverId != null">receiver_id = #{receiverId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            remark = #{remark},
            update_time = sysdate()
        </trim>
        where remind_id = #{remindId}
    </update>

    <delete id="deleteBizRemindByIds" parameterType="Long">
        delete from biz_remind where remind_id in
        <foreach collection="array" item="remindId" open="(" separator="," close=")">
            #{remindId}
        </foreach>
    </delete>
</mapper>
